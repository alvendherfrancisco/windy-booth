{
  "name": "User",
  "type": "object",
  "properties": {
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "lifetime"
      ],
      "default": "free"
    },
    "plan_renewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "sessions_used_this_month": {
      "type": "number",
      "default": 0
    },
    "sessions_period": {
      "type": "string"
    },
    "owned_collections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "downgrade_grace_until": {
      "type": "string",
      "format": "date-time"
    },
    "paymongo_customer_id": {
      "type": "string"
    },
    "paymongo_payment_method_id": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "avatar_source": {
      "type": "string",
      "enum": [
        "custom",
        "google"
      ]
    }
  }
}