{
  "name": "Template",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free"
    },
    "canvas_asset_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "code",
    "tier"
  ]
}