{
  "name": "Strip",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "is_guest": {
      "type": "boolean",
      "default": false
    },
    "guest_ip": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "video_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_video": {
      "type": "boolean",
      "default": false
    },
    "rendered_strip_url": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "saved": {
      "type": "boolean",
      "default": true
    },
    "filter_applied": {
      "type": "string",
      "enum": [
        "none",
        "sepia",
        "bw",
        "vintage",
        "vivid",
        "cool",
        "warm"
      ],
      "default": "none"
    }
  },
  "required": [
    "template_id",
    "photo_urls",
    "created_at",
    "saved"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_guest": true
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_guest": true
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_guest": true
        }
      ]
    }
  }
}